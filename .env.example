# ---------------------------------------------------------------------------
# profesionales.com.py — every variable the whole build needs (plan §5.1).
# Copy to .env for local dev. NEVER commit a real .env.
# On Hostinger these go in hPanel → Environment Variables, then redeploy.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Live app on Hostinger: host is localhost. Local dev against Hostinger MySQL:
# use the host shown on hPanel → Databases → Remote MySQL, and whitelist your IP.
DATABASE_URL="mysql://user:password@localhost:3306/profesionales"

# --- Auth (required) -------------------------------------------------------
# Signing key for the session cookie. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-random-32-byte-secret"
# Seeded administrator (scripts/seed.ts). Rotate immediately after first deploy.
ADMIN_EMAIL="admin@profesionales.com.py"
ADMIN_PASSWORD="change-me"

# --- Brand / domain (required; never hardcode these — plan §1.13) ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Profesionales"
# Business WhatsApp for "hablá con nosotros" CTAs. Optional.
NEXT_PUBLIC_BRAND_WHATSAPP=""

# --- Uploads (lead photos, plan §1.14) -------------------------------------
# Must point at persistent storage on Hostinger, outside the build output.
UPLOADS_DIR="./uploads"

# --- Email notifications (optional) ----------------------------------------
# Unset => notifications degrade to the dashboard inbox only (plan §5.2).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@profesionales.com.py"

# --- VenderCRM export (optional) -------------------------------------------
# Unset => professional export is a logged no-op (plan §1.10).
VENDERCRM_API_URL=""
VENDERCRM_API_KEY=""

# --- Spoke API (optional) --------------------------------------------------
# Plaintext bearer token seeded for local testing of POST /api/v1/spoke/leads.
# Only its SHA-256 hash is stored. Leave empty in production; create real tokens
# from the admin panel instead.
SPOKE_SEED_TOKEN=""
SPOKE_SEED_DOMAIN="localhost"

# --- Dev only --------------------------------------------------------------
# Password for the seeded demo professional. Not seeded when NODE_ENV=production.
DEMO_PRO_PASSWORD="demo-pro-1234"
# Set to "false" to skip the demo professional in a non-production seed.
SEED_DEMO="true"
